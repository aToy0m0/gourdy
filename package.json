{
  "name": "local-dictation-streaming",
  "version": "0.7.63",
  "private": true,
  "description": "Windows向けローカル音声入力",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "build:native": "powershell -NoProfile -ExecutionPolicy Bypass -File build-native.ps1",
    "predist": "npm run build:native",
    "dist": "electron-builder --win --x64 --dir",
    "test:nlp": ".venv\\Scripts\\python.exe -X utf8 -m unittest discover -s test -p test_nlp.py -v",
    "release:zip": "python scripts/package-release.py",
    "build:icons": "electron scripts/build-icons.cjs",
    "dist:installer": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "playwright": "1.63.0"
  },
  "build": {
    "appId": "jp.localdictation.streaming",
    "productName": "Gourdy",
    "asar": false,
    "extraFiles": [
      "README.md",
      "LICENSE",
      "licenses/**/*",
      {
        "from": "docs/public",
        "to": "docs/public"
      }
    ],
    "extraResources": [
      {
        "from": "runtime/llama",
        "to": "runtime/llama"
      },
      {
        "from": "runtime/python",
        "to": "runtime/python",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/pip/**",
          "!**/pip-*.dist-info/**",
          "!**/direct_url.json",
          "!bin/**",
          "!Scripts/**",
          "!Lib/site-packages/ja_ginza/**",
          "!Lib/site-packages/ja_ginza-*.dist-info/**"
        ]
      },
      {
        "from": "runtime/moonshine",
        "to": "runtime/moonshine",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*asio*",
          "!**/direct_url.json",
          "!bin/**",
          "!Scripts/**"
        ]
      },
      {
        "from": "runtime/ffmpeg",
        "to": "runtime/ffmpeg",
        "filter": [
          "ffmpeg.exe",
          "ffprobe.exe",
          "*.dll",
          "LICENSE.txt",
          "BUILD.txt"
        ]
      }
    ],
    "files": [
      "src/**/*",
      "package.json",
      "!src/transcribe.cjs",
      "!src/**/*.cs",
      "!src/**/__pycache__/**",
      "!src/style.css",
      "!**/*.map"
    ],
    "win": {
      "target": "dir",
      "signExecutable": false,
      "icon": "src/assets/gourdy.ico",
      "executableName": "Gourdy"
    },
    "directories": {
      "output": "dist-ui"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "gourdy-${version}-windows-x64-setup.${ext}",
      "installerLanguages": [
        "ja_JP",
        "en_US"
      ],
      "language": "1041",
      "packElevateHelper": false,
      "include": "build/installer.nsh"
    }
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "jsonc-parser": "3.3.1",
    "smol-toml": "1.8.0",
    "ws": "8.21.3"
  }
}
